modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["zip"]

[userenv]

[userenv.shared]
PORT = "3000"
JWT_SECRET = "tanimaster_jwt_secret_key_2024"
VITE_GOOGLE_CLIENT_ID = "439953948105-96d9rmmdv46vng8v1h3obvd6uet0abm2.apps.googleusercontent.com"
GOOGLE_CLIENT_ID = "439953948105-96d9rmmdv46vng8v1h3obvd6uet0abm2.apps.googleusercontent.com"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Backend && node server.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd Backend && node server.js & cd Frontend && npm run build && npx serve -s dist -l 5000"]
build = ["sh", "-c", "cd Backend && npm install && cd ../Frontend && npm install && npm run build"]
